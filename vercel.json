{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "ateliersdepaul.com" }],
      "destination": "https://www.ateliersdepaul.com/$1",
      "permanent": true
    },
    { "source": "/about", "destination": "/a-propos", "permanent": true },
    { "source": "/portfolio/bicec", "destination": "/portfolio/bicec_bafoussam", "permanent": true },
    { "source": "/about.html", "destination": "/a-propos", "permanent": true },
    { "source": "/projects/:slug", "destination": "/portfolio/:slug", "permanent": true },
    { "source": "/projects", "destination": "/portfolio", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/c/tifo-0001/vcf",
      "destination": "/public/contact/geordan-fokam-fotso.vcf"
    }
  ],
  "headers": [
    {
      "source": "/public/contact/(.*).vcf",
      "headers": [
        { "key": "Content-Type", "value": "text/vcard; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/c/tifo-0001/vcf",
      "headers": [
        { "key": "Content-Type", "value": "text/vcard; charset=utf-8" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"Geordan_FOKAM_FOTSO_ETS_TIFO.vcf\"" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/public/contact/Paul_Boubert.vcf",
      "headers": [
        { "key": "Content-Type", "value": "text/vcard; charset=utf-8" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"Paul_Boubert.vcf\"" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
