# ==============================================================================
# ADP WEB EXPERIENCE — VARIABLES D'ENVIRONNEMENT (MODÈLE .ENV.EXAMPLE)
# Date : Étape 03B — Initialisation Technique Contrôlée
# ==============================================================================
# IMPORTANT : Ne jamais committer de fichier .env contenant de vrais secrets.
# Ce fichier sert de référence pour la configuration locale et de production.
# ==============================================================================

# --- SERVEUR & URLS ---
PORT=3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- SÉCURITÉ PAYLOAD CMS & ADP CONTROL ---
# Chaîne aléatoire cryptographique d'au moins 32 caractères
PAYLOAD_SECRET=remplacer_par_une_cle_secrete_aleatoire_32_caracteres_min
ADP_ADMIN_SECRET=remplacer_par_une_cle_hmac_sha256_32_caracteres_min
ADP_ADMIN_PASSPHRASE=remplacer_par_votre_mot_de_passe_atelier_fort

# --- BASE DE DONNÉES POSTGRESQL (LOCAL / CI) ---
# Format : postgresql://<user>:<password>@<host>:<port>/<database>
# ATTENTION : Aucune base distante n'est créée à l'étape 03B.
# Pour le développement local, utiliser une instance PostgreSQL 16+ locale ou Docker :
# docker run --name adp-postgres -e POSTGRES_PASSWORD=adp_local_password -e POSTGRES_DB=adp_experience -p 5432:5432 -d postgres:16-alpine
DATABASE_URI=postgresql://postgres:adp_local_password@localhost:5432/adp_experience

# --- STOCKAGE MÉDIAS (CLOUDFLARE R2 - OPTIONNEL / PHASE ULTÉRIEURE) ---
# Non utilisé en développement local (stockage sur disque local dans /media)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=adp-medias-production
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_PUBLIC_DOMAIN=https://medias.ateliersdepaul.com

# --- NOTIFICATIONS & INTÉGRATIONS (ADP CONNECT - RESEND / SMTP / WHATSAPP) ---
RESEND_API_KEY=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=contact@ateliersdepaul.com
